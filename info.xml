<?xml version="1.0"?>
<extension key="nz.co.fuzion.telemetry" type="module">
  <file>telemetry</file>
  <name>CiviCRM Site Telemetry</name>
  <description>Collects CiviCRM site stats and sends them to a central monitoring dashboard. Successor to Archimedes for CiviCRM fleets.</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>Sachin Doijad</author>
    <email>sachin@fuzion.co.nz</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://github.com/fuzionnz/nz.co.fuzion.telemetry</url>
  </urls>
  <releaseDate>2026-06-29</releaseDate>
  <version>1.0.0</version>
  <develStage>alpha</develStage>
  <compatibility>
    <ver>5.45</ver>
  </compatibility>
  <mixins>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>mgd-php@1.0.0</mixin>
  </mixins>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
  </classloader>
</extension>
